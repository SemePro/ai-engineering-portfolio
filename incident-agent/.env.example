# Model access: gateway mode (preferred) ...
GATEWAY_URL=http://localhost:8000
GATEWAY_SERVICE_KEY=
# ... or direct mode for local development / evals
# ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
EFFORT=medium

# Required for the API: >= 32 random characters
APPROVAL_SIGNING_SECRET=
DATA_DIR=./var

# Public demo controls
DEMO_LIVE_ENABLED=false
DEMO_SESSIONS_PER_IP_PER_HOUR=3
DEMO_LIVE_RUNS_PER_SESSION=2
DEMO_DAILY_LIVE_RUNS=40
